# Copy to .env and fill in real values. Never commit .env.

# Database. SQLite by default for local dev; swap to a Postgres URL in production
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./tutor.db

# JWT signing secret — generate a long random value for any non-local environment.
JWT_SECRET=change-me-to-a-long-random-string

# Anthropic API key — required for Tutor, quiz generation/grading, recommendations,
# and concept extraction. Without it, those features fail gracefully (clear error
# state) rather than crash; material upload/chunking/embedding still works.
ANTHROPIC_API_KEY=

# Model overrides (optional — sensible defaults are set in app/config.py).
TUTOR_MODEL=claude-sonnet-5
QUIZ_MODEL=claude-sonnet-5
GRADING_MODEL=claude-sonnet-5
RECOMMENDATION_MODEL=claude-sonnet-5
